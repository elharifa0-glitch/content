# انسخ الملف ده واسمه .env واملا القيم من Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# مفتاح Refetcher — ده مش بيبدأ بـ VITE_ عن قصد، عشان يفضل مخفي على السيرفر
# بس ويستخدمه ملف api/analyze-video.js. لو حطيته بـ VITE_ هيبان في المتصفح لأي حد.
REFETCHER_API_KEY=pc_live_your_key_here
